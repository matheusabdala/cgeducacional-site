# ==========================================================================
# CG Educacional LMS — variáveis de ambiente (EXEMPLO)
# Copie para .env.local (dev) e preencha. NUNCA commitar valores reais.
# ==========================================================================

# --- Coolify (infra/deploy) ---
COOLIFY_APIKEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_PASS=

# Connection string para o Prisma (senha URL-encoded!).
# App (pooler, porta 6543) e migrations (direta, porta 5432).
DATABASE_URL=postgresql://postgres:SENHA_ENCODED@db.xxxxxxxx.supabase.co:5432/postgres
# DIRECT_URL=postgresql://postgres:SENHA_ENCODED@db.xxxxxxxx.supabase.co:5432/postgres

# --- Google OAuth (login via Supabase) ---
# Esses ficam no painel do Supabase (Auth > Providers > Google), não são usados pelo app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Drive (Service Account: vídeos padrão + arquivos) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=

# --- Gemini (assistente IA, opcional) ---
GEMINI_API_KEY=

# --- YouTube (opcional, fase futura) ---
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# --- Mercado Pago (fase futura) ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=
