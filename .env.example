# ==========================================================================
# CG Educacional LMS — variáveis de ambiente (EXEMPLO)
# Copie para .env.local (dev) e preencha. NUNCA commitar valores reais.
# ==========================================================================

# --- Coolify (infra/deploy) ---
COOLIFY_APIKEY=

# --- App ---
# URL pública do site (redirects de OAuth e e-mail). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_PASS=

# Connection strings para o Prisma (senha URL-encoded!).
# DATABASE_URL = pooler (Transaction, porta 6543) usado pelo app em runtime.
#   Acrescente ?pgbouncer=true&connection_limit=1 para o pooler.
# DIRECT_URL   = conexão direta (porta 5432) usada SÓ pelas migrations.
DATABASE_URL=postgresql://postgres.xxxxxxxx:SENHA_ENCODED@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.xxxxxxxx:SENHA_ENCODED@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# --- Google OAuth (login via Supabase) ---
# Esses ficam no painel do Supabase (Auth > Providers > Google), não são usados pelo app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Drive (Service Account: vídeos padrão + arquivos) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=

# --- Gemini (assistente IA, opcional) ---
GEMINI_API_KEY=

# --- Certimaker (geração de certificados) ---
CERTIMAKER_API_URL=https://certimaker.cgeducacional.com.br
# Token Bearer gerado no Certimaker (npm run apikey -- <email> "nome").
CERTIMAKER_API_KEY=

# --- YouTube (opcional, fase futura) ---
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# --- Mercado Pago (fase futura) ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=
