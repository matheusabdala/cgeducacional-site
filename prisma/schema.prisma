// CG Educacional LMS — modelo de dados (Prisma + Postgres/Supabase)
//
// `User.id` = id do usuário no Supabase Auth (auth.users.id, UUID). O perfil
// (role, nome, avatar) vive nesta tabela `public.User` e é criado no cadastro.
// O app acessa o banco via Prisma (server-side) com a connection string direta;
// as policies de RLS (ver prisma/rls.sql) são defesa em profundidade para
// acessos via cliente Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (PgBouncer, porta 6543) p/ runtime
  directUrl = env("DIRECT_URL") // conexão direta (porta 5432) p/ migrations
}

enum Role {
  student
  instructor
  admin
}

enum CourseLevel {
  iniciante
  intermediario
  avancado
}

enum CourseCategory {
  neurociencia
  pedagogia
  gestao
  inclusao
  musica
  historia
  artes_visuais
  seguranca_publica
  seguranca_trabalho
  letras
  hotelaria
  outros
}

// Provider de vídeo da aula. Drive é o padrão (baixo custo); YouTube unlisted
// é opcional. Hosts pagos (Bunny/Cloudflare) entram como novos valores depois.
enum VideoProvider {
  drive
  youtube
}

enum CourseModality {
  online
  presencial
  hibrido
}

enum OrderStatus {
  initiated // checkout aberto, sem pagamento ainda (carrinho)
  pending // pagamento criado, aguardando (PIX/processando)
  approved // pago
  rejected // recusado
  cancelled // cancelado/expirado
  refunded // estornado
}

enum PaymentMethod {
  pix
  credit_card
}

model User {
  id        String   @id @db.Uuid // = Supabase auth.users.id
  email     String   @unique
  name      String
  role      Role     @default(student)
  avatarUrl String?
  bio       String?
  cpf       String?  @unique // 11 dígitos (sem máscara) — exigido no cadastro
  certimakerAlunoId String? // id do aluno espelhado no Certimaker
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cursos onde este usuário é o instrutor
  coursesTeaching Course[]         @relation("CourseInstructor")
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  certificates    Certificate[]
  orders          Order[]

  @@index([role])
}

model Course {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  description     String
  fullDescription String?
  thumbnailUrl    String?
  category        CourseCategory
  level           CourseLevel    @default(iniciante)
  price           Decimal        @default(0) @db.Decimal(10, 2)
  durationLabel   String? // ex.: "40h" (rótulo livre p/ exibição)
  rating          Float          @default(0)
  studentsCount   Int            @default(0)
  published       Boolean        @default(false)
  // Dados acadêmicos (espelham o Curso do Certimaker — usados no certificado)
  programContent  String? // conteúdo programático / ementa
  workloadHours   Int? // carga horária em horas
  modality        CourseModality @default(online)
  location        String? // local (presencial/híbrido)
  startDate       DateTime?      @db.Date // data oficial de início da turma (vai no certificado)
  endDate         DateTime?      @db.Date // data oficial de término da turma (vai no certificado)
  // Liberação de conteúdo (opcional, por curso)
  requireSequential Boolean      @default(false) // trava aula até concluir a anterior
  dripEnabled       Boolean      @default(false) // libera X aulas e o resto após N dias
  dripInitialCount  Int          @default(0) // quantas aulas liberadas de imediato
  dripDelayDays     Int          @default(7) // dias até liberar o restante
  // Espelho no Certimaker (cache, p/ não recriar a cada emissão)
  certimakerCursoId String?
  certimakerTurmaId String?
  certimakerTemplateId String? // modelo do certificado deste curso (null = padrão)
  instructorId    String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  instructor   User          @relation("CourseInstructor", fields: [instructorId], references: [id])
  modules      Module[]
  enrollments  Enrollment[]
  certificates Certificate[]
  orders       Order[]

  @@index([instructorId])
  @@index([category])
  @@index([published])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id              String        @id @default(cuid())
  moduleId        String
  title           String
  description     String?
  order           Int
  durationSeconds Int?
  videoProvider   VideoProvider @default(drive)
  videoRef        String? // id no provider (Drive file id / YouTube video id)
  content         String? // conteúdo escrito da aula (texto longo)
  documentFileId  String? // PDF da aula exibido inline (Drive file id)
  materialFileId  String? // material de apoio p/ download (Drive file id)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String    @db.Uuid
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Order {
  id             String         @id @default(cuid())
  userId         String         @db.Uuid
  courseId       String
  status         OrderStatus    @default(initiated)
  method         PaymentMethod?
  baseAmount     Decimal        @db.Decimal(10, 2) // preço do curso
  discount       Decimal        @default(0) @db.Decimal(10, 2) // desconto (ex.: PIX)
  amount         Decimal        @db.Decimal(10, 2) // valor final cobrado
  installments   Int            @default(1)
  payerCpf       String? // CPF do titular do pagamento (11 dígitos, sem máscara)
  payerEmail     String?
  mpPaymentId    String?        @unique // id do pagamento no Mercado Pago
  mpStatusDetail String? // status_detail do MP (motivo de recusa etc.)
  pixQrCode      String? // copia-e-cola do PIX
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  paidAt         DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
}

model LessonProgress {
  id            String   @id @default(cuid())
  userId        String   @db.Uuid
  lessonId      String
  watchedSeconds Int     @default(0)
  completed     Boolean  @default(false)
  lastWatchedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Certificate {
  id             String   @id @default(cuid())
  userId         String   @db.Uuid
  courseId       String
  issuedAt       DateTime @default(now())
  certificateUrl String? // URL pública do PDF (Certimaker)
  code           String? // código de validação (8 chars) do Certimaker

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// ===========================================================================
// Assinatura eletrônica de documentos (módulo `server/esign`).
// Prefixo `Esign*` e SEM relação com `User` (só snapshot de id/nome do criador)
// para o módulo poder ser extraído para um produto próprio no futuro.
// ===========================================================================

enum EsignDocumentStatus {
  draft // rascunho: operador ainda posicionando campos
  pending // enviado, aguardando assinaturas
  completed // todos assinaram (imutável)
  cancelled // cancelado pelo operador (links param de funcionar)
}

enum EsignSignerStatus {
  pending
  signed
}

enum EsignFieldKind {
  signature
  name
  cpf
  date
}

enum EsignSignatureMethod {
  draw // desenhada (mouse/dedo) na própria página
  type // nome digitado em fonte cursiva
  phone // desenhada no celular via QR/link
}

enum EsignSessionKind {
  upload // enviar PDF pelo celular (operador)
  signature // desenhar a assinatura pelo celular (signatário)
}

model EsignDocument {
  id             String              @id @default(cuid())
  code           String              @unique // público, p/ validação (ex.: DOC-7K3M-Q2ZP)
  title          String
  status         EsignDocumentStatus @default(draft)
  originalPath   String // caminho no storage do PDF original
  originalName   String // nome do arquivo enviado
  originalMime   String              @default("application/pdf") // gancho p/ Word→PDF
  originalSha256 String
  originalSize   Int
  pageCount      Int
  pageSizes      Json // [{ x, y, w, h, rotate }] (CropBox em pontos)
  signedPath     String? // PDF com as assinaturas + relatório (regerado a cada assinatura)
  signedSha256   String?
  signedVersion  Int                 @default(0)
  requireOtp     Boolean             @default(true) // exige código por e-mail
  message        String? // mensagem do convite
  createdById    String              @db.Uuid // snapshot do operador (sem FK)
  createdByName  String
  sentAt         DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  signers  EsignSigner[]
  fields   EsignField[]
  events   EsignEvent[]
  sessions EsignSession[]

  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

model EsignSigner {
  id         String            @id @default(cuid())
  documentId String
  order      Int               @default(0)
  // Pré-definidos pelo operador (opcionais)
  name       String?
  email      String?
  cpf        String? // 11 dígitos; se definido, o signatário precisa informar o mesmo
  status     EsignSignerStatus @default(pending)
  // Link secreto (gerado no envio): só o hash para busca + versão cifrada p/ "copiar link"
  tokenHash  String?           @unique
  tokenEnc   String?
  viewedAt   DateTime?

  // Evidências da assinatura (snapshot do que a pessoa informou)
  signedName       String?
  signedCpf        String?
  signedEmail      String?
  signatureMethod  EsignSignatureMethod?
  signaturePath    String? // PNG no storage
  signatureSha256  String?
  typedText        String?
  signedAt         DateTime?
  signedIp         String?
  signedUserAgent  String?
  signedDevice     String?
  signedGeo        Json?
  phoneIp          String? // aparelho onde desenhou (método phone)
  phoneUserAgent   String?
  phoneDevice      String?

  // Código por e-mail (OTP)
  otpEmail      String?
  otpCodeHash   String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpSentAt     DateTime?
  otpSendCount  Int       @default(0)
  otpVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document EsignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fields   EsignField[]

  @@index([documentId])
}

model EsignField {
  id         String         @id @default(cuid())
  documentId String
  signerId   String
  kind       EsignFieldKind
  // Posição relativa à página exibida (0..1, origem no canto superior esquerdo)
  page       Int
  x          Float
  y          Float
  w          Float
  h          Float
  createdAt  DateTime       @default(now())

  document EsignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer   EsignSigner   @relation(fields: [signerId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([signerId])
}

// Trilha de auditoria com cadeia de hash (cada evento referencia o anterior).
model EsignEvent {
  id         String   @id @default(cuid())
  documentId String
  signerId   String?
  type       String // document_created, sent, link_opened, otp_sent, signer_signed, completed…
  ip         String?
  userAgent  String?
  data       Json?
  prevHash   String?
  hash       String
  createdAt  DateTime @default(now())

  document EsignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

// Sessões de QR code (uso único, curtas): upload pelo celular e assinatura pelo dedo.
model EsignSession {
  id          String           @id @default(cuid())
  kind        EsignSessionKind
  codeHash    String           @unique
  documentId  String?
  signerId    String?
  actorId     String?          @db.Uuid // operador (upload)
  actorName   String?
  expiresAt   DateTime
  consumedAt  DateTime?
  resultPath  String? // PNG da assinatura (signature)
  resultMeta  Json? // upload: { documentId } · signature: { ip, userAgent, device }
  createdAt   DateTime         @default(now())

  document EsignDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
