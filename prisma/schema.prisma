// CG Educacional LMS — modelo de dados (Prisma + Postgres/Supabase)
//
// `User.id` = id do usuário no Supabase Auth (auth.users.id, UUID). O perfil
// (role, nome, avatar) vive nesta tabela `public.User` e é criado no cadastro.
// O app acessa o banco via Prisma (server-side) com a connection string direta;
// as policies de RLS (ver prisma/rls.sql) são defesa em profundidade para
// acessos via cliente Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (PgBouncer, porta 6543) p/ runtime
  directUrl = env("DIRECT_URL") // conexão direta (porta 5432) p/ migrations
}

enum Role {
  student
  instructor
  admin
}

enum CourseLevel {
  iniciante
  intermediario
  avancado
}

enum CourseCategory {
  neurociencia
  pedagogia
  gestao
  inclusao
}

// Provider de vídeo da aula. Drive é o padrão (baixo custo); YouTube unlisted
// é opcional. Hosts pagos (Bunny/Cloudflare) entram como novos valores depois.
enum VideoProvider {
  drive
  youtube
}

model User {
  id        String   @id @db.Uuid // = Supabase auth.users.id
  email     String   @unique
  name      String
  role      Role     @default(student)
  avatarUrl String?
  bio       String?
  cpf       String?  @unique // 11 dígitos (sem máscara) — exigido no cadastro
  certimakerAlunoId String? // id do aluno espelhado no Certimaker
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cursos onde este usuário é o instrutor
  coursesTeaching Course[]         @relation("CourseInstructor")
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  certificates    Certificate[]

  @@index([role])
}

model Course {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  description     String
  fullDescription String?
  thumbnailUrl    String?
  category        CourseCategory
  level           CourseLevel    @default(iniciante)
  price           Decimal        @default(0) @db.Decimal(10, 2)
  durationLabel   String? // ex.: "40h"
  rating          Float          @default(0)
  studentsCount   Int            @default(0)
  published       Boolean        @default(false)
  // Liberação de conteúdo (opcional, por curso)
  requireSequential Boolean      @default(false) // trava aula até concluir a anterior
  dripEnabled       Boolean      @default(false) // libera X aulas e o resto após N dias
  dripInitialCount  Int          @default(0) // quantas aulas liberadas de imediato
  dripDelayDays     Int          @default(7) // dias até liberar o restante
  // Espelho no Certimaker (cache, p/ não recriar a cada emissão)
  certimakerCursoId String?
  certimakerTurmaId String?
  instructorId    String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  instructor   User          @relation("CourseInstructor", fields: [instructorId], references: [id])
  modules      Module[]
  enrollments  Enrollment[]
  certificates Certificate[]

  @@index([instructorId])
  @@index([category])
  @@index([published])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id              String        @id @default(cuid())
  moduleId        String
  title           String
  description     String?
  order           Int
  durationSeconds Int?
  videoProvider   VideoProvider @default(drive)
  videoRef        String? // id no provider (Drive file id / YouTube video id)
  content         String? // conteúdo escrito da aula (texto longo)
  documentFileId  String? // PDF da aula exibido inline (Drive file id)
  materialFileId  String? // material de apoio p/ download (Drive file id)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String    @db.Uuid
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id            String   @id @default(cuid())
  userId        String   @db.Uuid
  lessonId      String
  watchedSeconds Int     @default(0)
  completed     Boolean  @default(false)
  lastWatchedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Certificate {
  id             String   @id @default(cuid())
  userId         String   @db.Uuid
  courseId       String
  issuedAt       DateTime @default(now())
  certificateUrl String? // URL pública do PDF (Certimaker)
  code           String? // código de validação (8 chars) do Certimaker

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
